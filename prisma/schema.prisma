generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model ContentPiece {
  id               String            @id @default(cuid())
  workspaceId      String
  projectId        String
  brandId          String?
  createdByUserId  String
  title            String
  type             String            @default("blog_post")
  brief            String            @db.MediumText
  brandVoiceId     String?
  brandVoice       BrandVoice?       @relation("ContentPieceBrandVoice", fields: [brandVoiceId], references: [id], onDelete: Restrict)
  status           String            @default("draft")
  reviewToken      String?           @unique
  reviewExpiresAt  DateTime?
  platformContents PlatformContent[]
  reviewComments   ReviewComment[]
  quality          ContentQuality?
  qualityHistory   QualityHistory[]
  schedules        ContentSchedule[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([createdByUserId])
}

model PlatformContent {
  id             String       @id @default(cuid())
  contentPieceId String
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  platform       String
  status         String       @default("draft")
  content        String?      @db.MediumText
  publishedUrl   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([contentPieceId, platform])
}

model ReviewComment {
  id             String       @id @default(cuid())
  contentPieceId String
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  authorName     String
  comment        String?      @db.MediumText
  action         String
  createdAt      DateTime     @default(now())
}

// Business generation profile linked to a Brand ID owned by 智链.
model BrandVoice {
  id              String         @id @default(cuid())
  workspaceId     String
  brandId         String?
  name            String
  description     String?        @db.Text
  guidelines      String?        @db.Text
  samples         String         @db.MediumText
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  contentPieces   ContentPiece[] @relation("ContentPieceBrandVoice")

  @@index([workspaceId])
  @@index([brandId])
}

model AITemplate {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  description String?  @db.Text
  template    String   @db.MediumText
  variables   String   @db.MediumText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

model ContentQuality {
  id               String       @id @default(cuid())
  contentPieceId   String       @unique
  contentPiece     ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  quality          Int          @default(0)
  engagement       Int          @default(0)
  brandVoice       Int          @default(0)
  platformFit      Int          @default(0)
  sentiment        Int          @default(0)
  topicConsistency Int          @default(0)
  originality      Int          @default(0)
  localMetrics     String?      @db.MediumText
  suggestions      String?      @db.MediumText
  previousScores   String?      @db.MediumText
  evaluationCount  Int          @default(1)
  evaluatedAt      DateTime     @default(now())

  @@index([evaluatedAt])
}

model QualityHistory {
  id               String       @id @default(cuid())
  contentPieceId   String
  contentPiece     ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  quality          Int
  engagement       Int
  brandVoice       Int
  platformFit      Int
  sentiment        Int          @default(0)
  topicConsistency Int          @default(0)
  originality      Int          @default(0)
  contentHash      String
  evaluatedAt      DateTime     @default(now())

  @@index([contentPieceId, evaluatedAt])
}

model ContentSchedule {
  id           String       @id @default(cuid())
  contentId    String
  contentPiece ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  publishedAt  DateTime?
  status       String       @default("scheduled")
  createdAt    DateTime     @default(now())

  @@unique([contentId])
  @@index([scheduledAt])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  type        String
  title       String
  message     String   @db.MediumText
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([workspaceId])
}

model GenieSource {
  id              String   @id @default(cuid())
  workspaceId     String
  url             String
  businessType    String?
  keyProducts     String?  @db.MediumText
  brandTone       String?
  targetAudience  String?
  recurringTopics String?  @db.MediumText
  contentThemes   String?  @db.MediumText
  suggestedContentTypes String? @db.MediumText
  lastAnalyzedAt  DateTime?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId, enabled])
  @@unique([workspaceId, url])
  @@index([lastAnalyzedAt])
}

model PlatformApiConfig {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String   @default("")
  userId         String   @default("")
  platform       String
  appId          String?  @map("app_id")
  appSecret      String?  @map("app_secret")
  accessToken    String?  @map("access_token")
  refreshTokn    String?  @map("refresh_token")
  tokenExpiresAt DateTime?
  lastRefreshedAt DateTime?
  extraConfig    String?  @db.MediumText
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, projectId, userId, platform])
  @@index([workspaceId, enabled])
  @@index([projectId, userId])
}

model PublishHistory {
  id                String   @id @default(cuid())
  workspaceId       String
  platform          String
  platformContentId String
  title             String
  content           String   @db.MediumText
  status            String
  publishedUrl      String?
  platformPostId    String?  @map("platform_post_id")
  errorMessage      String?  @map("error_message") @db.Text
  attemptCount      Int      @default(0)
  lastAttemptAt     DateTime @default(now())
  completedAt       DateTime?
  createdAt         DateTime @default(now())

  @@index([workspaceId, platform])
  @@index([platformContentId])
  @@index([status])
  @@index([createdAt])
}

// 智见建议 → 智创内容的持久化创作方案（设计 §8.6）。
// JSON 一律 MediumText 字符串（仓库惯例），serde 见 src/lib/content-brief/serde.ts。
model ContentBrief {
  id                       String    @id @default(cuid())
  workspaceId              String
  projectId                String
  createdByUserId          String
  schemaVersion            Int       @default(1)
  revision                 Int       @default(1)
  status                   String    @default("baseline_ready") @db.VarChar(32)
  sourceType               String    @default("visibility_suggestion") @db.VarChar(64)
  sourceSuggestionId       String    @db.VarChar(191)
  sourceHash               String    @db.VarChar(64)
  sourceSnapshot           String    @db.MediumText
  projectSnapshot          String    @db.MediumText
  baselineBrief            String    @db.MediumText
  refinedCandidate         String?   @db.MediumText
  effectiveBrief           String    @db.MediumText
  generationMeta           String    @db.MediumText
  idempotencyKey           String    @db.VarChar(64)
  idempotencyRequestHash   String    @db.VarChar(64)
  refinementStatus         String    @default("queued") @db.VarChar(32)
  refinementAttempts       Int       @default(0)
  refinementNextAttemptAt  DateTime?
  refinementLockedBy       String?   @db.VarChar(64)
  refinementLockedUntil    DateTime?
  refinementLastError      String?   @db.Text
  // 提炼基线冻结（评审 R2）：入队时的 revision 与内容快照，用户后续编辑不影响本次提炼基线。
  refinementBaseRevision   Int?
  refinementBaseBrief      String?   @db.MediumText
  // PATCH 幂等重放（评审 R8）：记录最近一次保存的键/请求哈希/首次响应。
  lastPatchKey             String?   @db.VarChar(64)
  lastPatchHash            String?   @db.VarChar(64)
  lastPatchResponse        String?   @db.MediumText
  confirmedAt              DateTime?
  expiresAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workflows                ContentWorkflow[]

  @@unique([workspaceId, projectId, idempotencyKey])
  @@index([workspaceId, projectId, sourceSuggestionId])
  @@index([refinementStatus, refinementNextAttemptAt, refinementLockedUntil])
}

// 内容创建工作流（设计 §8.6）：一个 Brief 修订 → 一个 ContentPiece + N 个平台运行。
model ContentWorkflow {
  id                     String   @id @default(cuid())
  workspaceId            String
  projectId              String
  briefId                String
  brief                  ContentBrief @relation(fields: [briefId], references: [id])
  briefRevision          Int
  briefSnapshot          String   @db.MediumText
  // 契约允许携带 templateId（评审覆盖审计）：持久化用于追溯；v1 生成提示词尚未消费。
  templateId             String?  @db.VarChar(64)
  contentPieceId         String?  @unique
  usageOperationId       String   @unique @db.VarChar(191)
  usageStatus            String   @default("reserved") @db.VarChar(32)
  idempotencyKey         String   @db.VarChar(64)
  idempotencyRequestHash String   @db.VarChar(64)
  status                 String   @default("queued") @db.VarChar(32)
  failureCode            String?  @db.VarChar(64)
  failureMessage         String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  completedAt            DateTime?
  runs                   ContentGenerationRun[]

  @@unique([workspaceId, projectId, idempotencyKey])
  @@index([workspaceId, projectId, status])
  @@index([status])
}

// 平台生成运行（设计 §8.6/§12.4）：租约列支持 worker 条件领取与接管。
model ContentGenerationRun {
  id                String   @id @default(cuid())
  workflowId        String
  workflow          ContentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  platform          String   @db.VarChar(32)
  platformContentId String?
  status            String   @default("queued") @db.VarChar(32)
  attemptCount      Int      @default(0)
  nextAttemptAt     DateTime?
  lockedBy          String?  @db.VarChar(64)
  lockedUntil       DateTime?
  startedAt         DateTime?
  completedAt        DateTime?
  failureCode       String?  @db.VarChar(64)
  failureMessage    String?  @db.Text
  providerRequestId String?  @db.VarChar(191)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([workflowId, platform])
  @@index([status, nextAttemptAt, lockedUntil])
}
